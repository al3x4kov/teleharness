{
  "name": "teleharness",
  "version": "2.5.2",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "teleharness": "bin/teleharness.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "demo": "node scripts/demo.mjs",
    "test": "node tests/run-tests.mjs all",
    "test:unit": "node tests/run-tests.mjs unit",
    "test:server": "node tests/run-tests.mjs server",
    "test:components": "node --test --test-timeout=60000 \"tests/components/*.test.js\"",
    "test:batched": "node tests/run-tests.mjs all --batch=4",
    "graph:fresh": "node scripts/graph-fresh.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "dompurify": "^3.2.0",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.11.0",
    "marked": "^16.0.0",
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4"
  },
  "description": "Self-hosted control room for AI coding agents (Claude Code, Codex, Gemini/ACP, opencode): mobile-first chat, Attention Board, diff review & Plan-First, git worktrees, API-equivalent costs, cross-CLI handoff, and Temporal pipelines with GitHub background agents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/al3x4kov/teleharness.git"
  },
  "homepage": "https://github.com/al3x4kov/teleharness",
  "keywords": [
    "claude-code",
    "codex",
    "gemini",
    "acp",
    "copilot",
    "opencode",
    "ai-agents",
    "coding-agent",
    "agent-orchestration",
    "agentic-workflow",
    "temporal",
    "github-automation",
    "human-in-the-loop",
    "git-worktrees",
    "cost-tracking",
    "multi-agent",
    "self-hosted",
    "mobile",
    "pwa",
    "mcp"
  ]
}
