{
  "name": "teleharness",
  "version": "1.19.4",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "demo": "node scripts/demo.mjs",
    "test": "node tests/run-tests.mjs all",
    "test:unit": "node tests/run-tests.mjs unit",
    "test:server": "node tests/run-tests.mjs server",
    "test:components": "node --test --test-timeout=60000 \"tests/components/*.test.js\"",
    "test:batched": "node tests/run-tests.mjs all --batch=4",
    "graph:fresh": "node scripts/graph-fresh.mjs"
  },
  "devDependencies": {
    "@preact/signals": "^2.0.0",
    "dompurify": "^3.2.0",
    "esbuild": "^0.25.0",
    "happy-dom": "^21.0.4",
    "highlight.js": "^11.11.0",
    "marked": "^16.0.0",
    "preact": "^10.26.0"
  },
  "description": "Mobile-first web portal for coding-agent CLIs (Claude Code, opencode) with their full harness: agents, skills, MCP, Obsidian memory.",
  "repository": {
    "type": "git",
    "url": "https://github.com/al3x4kov/teleharness.git"
  },
  "homepage": "https://github.com/al3x4kov/teleharness",
  "keywords": [
    "claude-code",
    "opencode",
