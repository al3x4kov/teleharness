# ─────────────────────────────────────────────────────────────────────────────
#  Teleharness — переменные окружения
#  Скопируйте в .env или задайте в окружении сервиса.
#  Полная схема с типами и валидацией: lib/config.js, docs/architecture.md §5.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ключи и токены ───────────────────────────────────────────────────────────
# OAuth-токен подписки Claude для claude CLI (`claude setup-token`)
CLAUDE_CODE_OAUTH_TOKEN=
# Токен администратора портала. Пусто → сгенерируется и запишется в data/admin-token.txt
TELEHARNESS_ADMIN_TOKEN=
# Ключ Z.ai Coding Plan для opencode (`opencode auth login` → zai-coding-plan) —
# opencode хранит его сам, порталу он не нужен.
TELEHARNESS_API_KEY=
# Пароль HTTP Basic для `opencode serve` (opencode v2 / config/opencode/service.json)
OPENCODE_SERVER_PASSWORD=

# ── Сервер ───────────────────────────────────────────────────────────────────
PORT=4170
TELEHARNESS_ENV=prod                          # prod | stand | test
TELEHARNESS_UPSTREAM=http://127.0.0.1:4096    # opencode serve (1.x); для opencode 2.x — http://127.0.0.1:4196
TELEHARNESS_OC_API=v1                         # v1 | v2 (opencode 2.x; ops/web-v2.sh ставит v2 сам)
TELEHARNESS_OC_PASSWORD=                      # пароль HTTP Basic opencode serve 2.x (ops/web-v2.sh читает его из ~/.teleharness/oc2-password)
TELEHARNESS_HOME=                              # по умолчанию домашняя папка
TELEHARNESS_DATA_DIR=                          # по умолчанию ./data
TELEHARNESS_COOKIE_NAME=teleharness_t                  # на стенде — отдельное имя (куки не скоупятся по порту)
TELEHARNESS_MOCK=false
TELEHARNESS_PUBLIC_URL=                        # публичный https-адрес корня портала (https://host/teleharness/) для QR «Подключить телефон»; пусто — QR нет
TELEHARNESS_AUTO_RELAY_DELAY_MS=               # пауза перед авто-передачей чата при лимите; пусто → 1500

# ── Файлы и база знаний ──────────────────────────────────────────────────────
TELEHARNESS_FILE_ROOTS=                        # по умолчанию TELEHARNESS_HOME; несколько — через ;
TELEHARNESS_KB_ROOT=off                        # папка Obsidian agents (снапшот базы знаний) или off
TELEHARNESS_TENANT_HOME=                       # по умолчанию <TELEHARNESS_HOME>/.teleharness-tenants
TELEHARNESS_TENANT_VAULT=                      # по умолчанию ~/.teleharness/tenants-vault

# ── Claude CLI ───────────────────────────────────────────────────────────────
TELEHARNESS_CLAUDE_BIN=                        # пусто → ~/.local/bin/claude(.exe), иначе `claude` из PATH
TELEHARNESS_CLAUDE_MCP_CONFIG=
TELEHARNESS_CLAUDE_TIMEOUT_MS=0
TELEHARNESS_CLAUDE_IDLE_MS=0
TELEHARNESS_TITLE_MODEL=claude-haiku-4-5

# ── Codex CLI (третий движок, только администратор) ──────────────────────────
TELEHARNESS_CODEX=                             # off — выключить Codex; пусто → включён, если codex установлен и выполнен вход
TELEHARNESS_CODEX_BIN=                         # пусто → codex из глобальных npm-пакетов, затем из PATH
TELEHARNESS_CODEX_SHIM=                        # пусто → lib/codex-shim.mjs

# ── Модели z.ai ──────────────────────────────────────────────────────────────
TELEHARNESS_GLM_VARIANT=max                    # off | low | high | max
TELEHARNESS_TENANT_VISION_MODEL=glm-5.3-flash
TELEHARNESS_DEFAULT_MODEL=

# ── Голос и push ─────────────────────────────────────────────────────────────
TELEHARNESS_VOICE=true
TELEHARNESS_VOICE_PYTHON=                      # по умолчанию ~/.teleharness/voice/venv (Scripts\python.exe | bin/python3)
TELEHARNESS_VOICE_MODELS=                      # по умолчанию ~/.teleharness/voice/models
TELEHARNESS_PUSH=true
TELEHARNESS_PUSH_SUBJECT=https://example.com/teleharness/

# ── Edge (ops/portal-server.js) ─────────────────────────────────────────────
TELEHARNESS_TLS_CERT=
TELEHARNESS_TLS_KEY=
TELEHARNESS_TLS_CA=
TELEHARNESS_TLS_PUBLIC_CERT=
TELEHARNESS_TLS_PUBLIC_KEY=
TELEHARNESS_TLS_PUBLIC_NAMES=
TELEHARNESS_HTTPS_ONLY=false

# ── Сборка ───────────────────────────────────────────────────────────────────
TELEHARNESS_OUT_DIR=                           # куда собирать фронт (например папка стенда)
TELEHARNESS_BUILD_PROD=0
