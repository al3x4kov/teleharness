# ─────────────────────────────────────────────────────────────────────────────
#  zai portal — переменные окружения
#  Скопируйте в .env или задайте в окружении сервиса.
#  Полная схема с типами и валидацией: lib/config.js, docs/architecture.md §5.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ключи и токены ───────────────────────────────────────────────────────────
# OAuth-токен подписки Claude для claude CLI (`claude setup-token`)
CLAUDE_CODE_OAUTH_TOKEN=
# Токен администратора портала. Пусто → сгенерируется и запишется в data/admin-token.txt
ZAI_ADMIN_TOKEN=
# Ключ Z.ai Coding Plan для opencode (`opencode auth login` → zai-coding-plan) —
# opencode хранит его сам, порталу он не нужен.
ZAI_API_KEY=
# Пароль HTTP Basic для `opencode serve` (opencode v2 / config/opencode/service.json)
OPENCODE_SERVER_PASSWORD=

# ── Сервер ───────────────────────────────────────────────────────────────────
PORT=4170
ZAI_ENV=prod                          # prod | stand | test
ZAI_UPSTREAM=http://127.0.0.1:4096    # opencode serve
ZAI_HOME=                              # по умолчанию домашняя папка
ZAI_DATA_DIR=                          # по умолчанию ./data
ZAI_COOKIE_NAME=zai_t                  # на стенде — отдельное имя (куки не скоупятся по порту)
ZAI_MOCK=false

# ── Файлы и база знаний ──────────────────────────────────────────────────────
ZAI_FILE_ROOTS=                        # по умолчанию ZAI_HOME; несколько — через ;
ZAI_KB_ROOT=off                        # папка Obsidian agents (снапшот базы знаний) или off
ZAI_TENANT_HOME=                       # по умолчанию <ZAI_HOME>/.zai-tenants
ZAI_TENANT_VAULT=                      # по умолчанию ~/.zai/tenants-vault

# ── Claude CLI ───────────────────────────────────────────────────────────────
ZAI_CLAUDE_BIN=                        # пусто → ~/.local/bin/claude(.exe), иначе `claude` из PATH
ZAI_CLAUDE_MCP_CONFIG=
ZAI_CLAUDE_TIMEOUT_MS=0
ZAI_CLAUDE_IDLE_MS=0
ZAI_TITLE_MODEL=claude-haiku-4-5

# ── Модели z.ai ──────────────────────────────────────────────────────────────
ZAI_GLM_VARIANT=max                    # off | low | high | max
ZAI_TENANT_VISION_MODEL=glm-5.3-flash
ZAI_DEFAULT_MODEL=

# ── Голос и push ─────────────────────────────────────────────────────────────
ZAI_VOICE=true
ZAI_VOICE_PYTHON=                      # по умолчанию ~/.zai/voice/venv (Scripts\python.exe | bin/python3)
ZAI_VOICE_MODELS=                      # по умолчанию ~/.zai/voice/models
ZAI_PUSH=true
ZAI_PUSH_SUBJECT=https://example.com/zai/

# ── Edge (ops/portal-server.js) ─────────────────────────────────────────────
ZAI_TLS_CERT=
ZAI_TLS_KEY=
ZAI_TLS_CA=
ZAI_TLS_PUBLIC_CERT=
ZAI_TLS_PUBLIC_KEY=
ZAI_TLS_PUBLIC_NAMES=
ZAI_HTTPS_ONLY=false

# ── Сборка ───────────────────────────────────────────────────────────────────
ZAI_OUT_DIR=                           # куда собирать фронт (стенд: D:\zai-stage\public)
ZAI_BUILD_PROD=0
