# Teleharness configuration — copy to .env and uncomment what you need.
# Every setting is optional: defaults live under your home folder (~/.teleharness)
# and the repo data/ directory. Boolean flags use 1 (on) or 0 (off).
# Full setup guide for every feature: docs/installation.md

# ── Server & network ─────────────────────────────────────────────────────────
# PORT=4170
# TELEHARNESS_LISTEN_HOST=127.0.0.1            # keep loopback; expose via reverse proxy / TLS
# TELEHARNESS_PUBLIC_URL=https://example.com/teleharness/  # enables phone QR sign-in links
# TELEHARNESS_DATA_DIR=                        # default: <repo>/data
# TELEHARNESS_LOG_DIR=                         # default: <data>/logs
# TELEHARNESS_HOME=                            # default: current user home directory
# TELEHARNESS_FILE_ROOTS=                      # semicolon-separated allowed file roots (default: HOME)
# TELEHARNESS_ACCESS_LOG=1
# TELEHARNESS_ADMIN_TOKEN=                     # leave empty to auto-generate data/admin-token.txt

# ── Engine 1: OpenCode 2.x (ops/opencode/serve-v2.sh or serve-v2.cmd) ───────
# When running ./ops/web-v2.sh, these are set automatically from ~/.teleharness/oc2-password.
# TELEHARNESS_OC_API=v2                        # v2 (opencode 2.x, recommended) | v1 (legacy 1.x)
# TELEHARNESS_UPSTREAM=http://127.0.0.1:4196
# TELEHARNESS_OC_PASSWORD=                     # must match OPENCODE_SERVER_PASSWORD of opencode serve
# TELEHARNESS_DEFAULT_MODEL=                   # optional "provider/model" fallback
# TELEHARNESS_GLM_VARIANT=max                  # off | low | high | max (for zai-coding-plan GLM models)

# ── Engine 2: Claude Code CLI ────────────────────────────────────────────────
# Sign in once via: claude setup-token  (or interactive claude login)
# CLAUDE_CODE_OAUTH_TOKEN=
# TELEHARNESS_CLAUDE_BIN=                      # default: ~/.local/bin/claude(.exe), then PATH
# TELEHARNESS_CLAUDE_MCP_CONFIG=               # optional MCP JSON config for admin Claude chats
# TELEHARNESS_CLAUDE_TIMEOUT_MS=0              # 0 = wait until turn finishes
# TELEHARNESS_CLAUDE_IDLE_MS=0                 # 0 = no idle kill (opt-in)
# TELEHARNESS_TITLE_LLM=1                      # auto chat titles via Claude Haiku (0 = heuristic only)
# TELEHARNESS_TITLE_MODEL=claude-haiku-4-5

# ── Engine 3: OpenAI Codex CLI ───────────────────────────────────────────────
# Sign in once via: codex login
# TELEHARNESS_CODEX=                           # set to "off" to disable; empty = auto-detect if signed in
# TELEHARNESS_CODEX_BIN=                       # default: global npm bin, then PATH
# TELEHARNESS_CODEX_SHIM=                      # default: lib/codex-shim.mjs

# ── Engine 4: ACP agents (Gemini CLI, Antigravity, GitHub Copilot CLI) ──────
# Install & sign in directly from Settings -> ACP Agents in the web UI.
# TELEHARNESS_ACP=                             # set to "off" to disable ACP integration

# ── Obsidian knowledge base & cross-engine handoff journal (optional) ────────
# Point at a folder inside your Obsidian vault to enable KB snapshots & chat journals.
# TELEHARNESS_KB_ROOT=off                      # e.g. /home/you/Obsidian/agents or C:\Users\you\Obsidian\agents

# ── Durable pipelines (Temporal, optional, Linux & macOS) ────────────────────
# See docs/temporal.md and docs/installation.md for Temporal server + PostgreSQL + Python worker setup.
# TELEHARNESS_TEMPORAL_PIPELINES=0
# TELEHARNESS_TEMPORAL_MODELS=claude,codex,acp,opencode
# TELEHARNESS_TEMPORAL_SUBSCRIPTION_ATTESTED=1
# TELEHARNESS_TEMPORAL_DRAIN=0

# ── GitHub Background Agents (optional) ──────────────────────────────────────
# Configure PAT, repos and rules in Settings -> Background Agents.
# TELEHARNESS_GITHUB_API=                      # default: https://api.github.com (override for GHE)

# ── Local Voice mode (Piper TTS + GigaAM STT, optional, CPU only) ────────────
# See ops/voice/README.md for Python venv + models installation.
# TELEHARNESS_VOICE=1
# TELEHARNESS_VOICE_PYTHON=                    # default: ~/.teleharness/voice/venv/{bin/python3,Scripts\python.exe}
# TELEHARNESS_VOICE_MODELS=                    # default: ~/.teleharness/voice/models
# TELEHARNESS_VOICE_TENANT_TTS_CHARS=40000
# TELEHARNESS_VOICE_TENANT_STT_SEC=1800

# ── Web Push notifications (requires HTTPS) ──────────────────────────────────
# TELEHARNESS_PUSH=1
# TELEHARNESS_PUSH_SUBJECT=https://example.com/teleharness/

# ── Multi-user tenants & quotas (optional) ───────────────────────────────────
# TELEHARNESS_TENANT_HOME=                     # default: ~/.teleharness-tenants
# TELEHARNESS_TENANT_VAULT=                    # default: ~/.teleharness/tenants-vault
# TELEHARNESS_TENANT_AGENT=
# TELEHARNESS_TENANT_VISION_MODEL=glm-5.3-flash
# TELEHARNESS_TENANT_PROMPT_LIMIT=8388608      # 8 MiB
# TELEHARNESS_TENANT_UPLOAD_LIMIT=26214400     # 25 MiB per file
# TELEHARNESS_TENANT_UPLOAD_QUOTA=524288000    # 500 MiB per tenant
# TELEHARNESS_TENANT_RATE_PER_MIN=120

# ── Bundled HTTPS edge proxy (ops/portal-server.js, optional) ────────────────
# Alternatively use Tailscale Serve, Caddy, or nginx.
# TELEHARNESS_TLS_CERT=
# TELEHARNESS_TLS_KEY=
# TELEHARNESS_TLS_CA=
# TELEHARNESS_TLS_PUBLIC_CERT=
# TELEHARNESS_TLS_PUBLIC_KEY=
# TELEHARNESS_TLS_PUBLIC_NAMES=
# TELEHARNESS_EDGE_ALLOWED_HOSTS=              # comma-separated allowed Host headers
# TELEHARNESS_HTTPS_ONLY=0

# ── Reliability, search & maintenance ────────────────────────────────────────
# TELEHARNESS_STALL_ABORT_MS=900000
# TELEHARNESS_LOOP_ABORT_COUNT=8
# TELEHARNESS_GC_ENABLED=1
# TELEHARNESS_GC_EMPTY_MIN=30
# TELEHARNESS_MEM_WARN_MB=1500
# TELEHARNESS_SEARCH_NO_BG=0                   # set 1 to disable background SQLite FTS5 indexing

# ── Temporal pipelines & external workflows (optional, Linux/macOS) ──────────
# TELEHARNESS_TEMPORAL_PIPELINES=0             # set 1 to enable Temporal pipelines
# TELEHARNESS_TEMPORAL_MODELS=claude,codex,acp,opencode
# TELEHARNESS_TEMPORAL_CLI=                    # path to `temporal` CLI (auto-found in PATH)
# TELEHARNESS_TEMPORAL_ADDRESS=127.0.0.1:17235 # e.g. 127.0.0.1:7233 for local dev server
# TELEHARNESS_TEMPORAL_NAMESPACE=teleharness-production
# TELEHARNESS_TEMPORAL_QUEUE=teleharness-prod-pipeline-v1
# TELEHARNESS_TEMPORAL_LEDGER=postgres         # set "none" for local mode without PostgreSQL (command/timer/approval/condition/artifact steps)
# TELEHARNESS_TEMPORAL_COMMAND_SLOTS=2         # max concurrent Command steps (1..32)
# TELEHARNESS_TEMPORAL_COMMAND_ROOTS=          # semicolon-separated allowed roots for exec commands
# TELEHARNESS_TEMPORAL_MODEL_SOCKET=           # short Unix socket path (<=103 B macOS, <=107 B Linux)
# TELEHARNESS_TEMPORAL_UI_URL=                 # optional Temporal Web UI base URL (e.g. http://127.0.0.1:8233)
# TELEHARNESS_TEMPORAL_DRAIN=0                 # set 1 to pause new runs & schedule resumes

# ── Build & development ──────────────────────────────────────────────────────
# TELEHARNESS_OUT_DIR=                         # alternate output folder for build.mjs
# TELEHARNESS_BUILD_PROD=0                     # set 1 to write to public/
